# Runtime
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=
REFRESH_TOKEN=

# Apify: comma-separated pool. APIFY_TOKEN is a legacy single-key fallback.
APIFY_TOKENS=
APIFY_TOKEN=
APIFY_KEY_MAX_ATTEMPTS=4
APIFY_KEY_COOLDOWN_SECONDS=300

# Gemini: comma-separated pool. GEMINI_API_KEY is a legacy single-key fallback.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_KEY_MAX_ATTEMPTS=4
GEMINI_KEY_COOLDOWN_SECONDS=300
