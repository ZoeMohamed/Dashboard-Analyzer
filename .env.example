# Runtime
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
ACTIVE_SOURCES=tiktok,instagram,facebook,maps,shopee,youtube
SOURCE_RESULT_LIMIT=50
SNAPSHOT_EVIDENCE_LIMIT=100
MAX_ACTIVE_TOPICS=20
SOURCE_TTL_MINUTES=360
DEFAULT_CITY=Bandung
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MAX_RUNS_PER_TICK=6
REFRESH_TOKEN=

# Apify: comma-separated pool. APIFY_TOKEN is a legacy single-key fallback.
APIFY_TOKENS=
APIFY_TOKEN=
APIFY_KEY_MAX_ATTEMPTS=4
APIFY_KEY_COOLDOWN_SECONDS=300
APIFY_DAILY_RUN_LIMIT=30
APIFY_ACTOR_TIMEOUT_SECONDS=600

# Gemini: comma-separated pool. GEMINI_API_KEY is a legacy single-key fallback.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_KEY_MAX_ATTEMPTS=4
GEMINI_KEY_COOLDOWN_SECONDS=300
GEMINI_MONTHLY_ANALYSIS_LIMIT=300
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RPM=8
GEMINI_BATCH_SIZE=25

# YouTube: empty uses public search pages instead of Data API v3.
YOUTUBE_API_KEY=
