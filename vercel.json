{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/index.py" },
    { "src": "/(.*)", "dest": "/$1", "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.py" }
  ]
}
